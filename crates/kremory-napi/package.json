{
  "name": "@kgentic/kremory-node",
  "version": "0.1.5-alpha.0",
  "description": "Node.js binding for the kremory bi-temporal agent memory engine",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "name": "kremory",
    "triples": {
      "defaults": true,
      "additional": [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
        "x86_64-pc-windows-msvc"
      ]
    }
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublish -t npm",
    "version": "napi version"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kgentic/kremory"
  }
}
