# Rust
/target/
# Separate CARGO_TARGET_DIR for e2e-consumer runs — keeps the E2E build cache
# out of the main target/ so a workspace rebuild does not evict it (and vice versa).
/target-e2e/
**/target/
Cargo.lock.bak
*.rs.bk

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local env / secrets
.env
.env.local

# Local Claude / aidocs runtime state
.claude/sessions/
.ship/
.ai-docs/.cache/

# codebase-memory-mcp local index
.index.db
.index.db-*

# policy MCP local cache
.policy/

# kremory-eval runtime output (not committed)
crates/kremory-eval/eval_results/
crates/kremory-eval/output/
crates/kremory-eval/.cache/

# Logs from kremory dev runs
crates/*/logs/
crates/*/*.log

# Test artefacts
crates/*/tests/output/
crates/*/fixtures/output/
.gahrc

# Claude Code runtime artifacts
.claude/scheduled_tasks.lock
librust_out.rlib
repomix-output.xml
repomix-eval-output.xml
repomix-*.xml

# Local Claude agent worktrees (created by Agent tool with isolation: "worktree")
.claude/worktrees/

# Obsidian — vault is rooted at .ai-docs/. Track config, ignore user-local state.
# Obsidian vault config at the REPO ROOT. The .ai-docs/.obsidian/* siblings below
# were already ignored; this one was not, and it blocked gah's pre-push clean check.
/.obsidian/
.ai-docs/.obsidian/workspace.json
.ai-docs/.obsidian/workspaces.json
.ai-docs/.obsidian/workspace-mobile.json
.ai-docs/.obsidian/cache
.ai-docs/.obsidian/graph.json
.ai-docs/_attachments/

spike/community_detect_bin

# e2e consumer artifacts
*.node
e2e-consumer/target/
e2e-consumer/*.log
e2e-consumer-napi/node_modules/
e2e-consumer-napi/*.log
crates/kremory-napi/*.node
crates/kremory-napi/index.js
crates/kremory-napi/index.d.ts

# stray test rlib artifact
libqtest_arity.rlib
*.rlib

# Scratch clones of OSS repos for source-level teardown research (see oss-teardown skill)
/oss/

# Third-party OSS clones for teardown (never commit)
oss/
repomix-output.xml

# graphify code-graph output (build artefact)
graphify-out/
.graphify_*.json
# graphify's pre-install backup of .claude/settings.json — local, recreated on every
# re-install, and the live settings.json is tracked so the backup is pure noise.
*.graphify-bak

# Benchmark scratch databases — regenerated by a bench run, 80-110MB each
bench.db
bench-*.db

# Empty/partial bench result scratch
bench/longmemeval/results/
